\RequirePackage{color}		% Permet d'inclure du texte en couleur
\RequirePackage{hyperref}		% Pour inclure des liens dans le document
\hypersetup{
	colorlinks=true,
	linkcolor=black,
	citecolor=gruvGreen,
	filecolor=gruvRed,
	urlcolor=gruvBlue,
}
