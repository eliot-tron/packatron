	\tcolorboxenvironment{warning}{arc=0ex, colback=colSoftImportant, colframe=colImportant!60, left=3pt, right=3pt, top=-3pt, bottom=2pt, breakable, attach boxed title to top center={yshift=-2mm}, title=\warningtext, enhanced, colbacktitle=colImportant!60}
	\renewcommand{\exosol}[2]{\begin{exo} #1 \tcbline \textit{Solution.} #2 \end{exo}}
}{}


\newcommand{\standoutmessage}[1]{
    \begin{tikzpicture}[remember picture, overlay]
      \fill[white, opacity=0.6] (current page.south west) rectangle (current page.north east);
      \node[text width=0.6\textwidth, align=center, font=\Large, opacity=1]
        at (current page.center) {
								#1
        };
    \end{tikzpicture}
}
